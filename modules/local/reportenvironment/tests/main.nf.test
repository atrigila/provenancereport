nextflow_process {

    name "Test Process REPORTENVIRONMENT"
    script "../main.nf"
    process "REPORTENVIRONMENT"

    tag "modules"
    tag "modules_local"
    tag "reportenvironment"

    test("collect report runtime environment") {

        when {
            process {
                """
                input[0] = 'docker'
                """
            }
        }

        then {
            assertAll {
                { assert process.success }
                { assert snapshot(process.out).match() }
            }
        }
    }
}
