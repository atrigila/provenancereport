nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'ro-crate-metadata_*.json'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            def multiqc_report = path("$outputDir/multiqc/multiqc_report.html")
            def software_versions = path("$outputDir/pipeline_info/nf_core_provenancereport_software_mqc_versions.yml")
            assert workflow.success
            assertAll(
                { assert stable_path.findAll { path -> path.startsWith("quartonotebook/") && path.endsWith(".html") }.size() == 1 },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_provenancereport_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() },
                { assert multiqc_report.exists() },
                { assert !multiqc_report.text.contains('A reproducibility-focused description of how this report was produced.') },
                { assert !multiqc_report.text.contains('this information is collected when the pipeline is started.') },
                { assert multiqc_report.text.contains('id="nf-core-provenancereport-runtime-environment"') },
                { assert multiqc_report.text.contains('community.wave.seqera.io/library/jupyter_matplotlib_papermill_quarto_r-rmarkdown:6d15193ce3dfc665') },
                { assert software_versions.text.contains('QUARTONOTEBOOK:') },
                { assert software_versions.text.contains('  quarto: 1.7.31') },
                { assert !software_versions.text.contains('  papermill:') },
                { assert multiqc_report.text.indexOf('<h2 class="mb-0" id="input_samplesheet">') < multiqc_report.text.indexOf('<h2 class="mb-0" id="multiqc_software_versions">') },
            )
        }
    }
}
