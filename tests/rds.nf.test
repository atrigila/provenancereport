nextflow_pipeline {

    name "Test pipeline with external RDS input"
    script "../main.nf"
    config "tests/assets/quartonotebook_rds.config"
    tag "pipeline"
    tag "rds"

    test("-profile test with external RDS input") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'ro-crate-metadata_*.json'])
            def multiqc_report = path("$outputDir/multiqc/multiqc_report.html")
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert stable_path.findAll { path -> path == "quartonotebook/artifacts/external_rds_summary.tsv" }.size() == 1 },
                { assert stable_path.findAll { path -> path.startsWith("quartonotebook/") && path.endsWith(".html") }.size() == 1 },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_provenancereport_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() },
                { assert path("$outputDir/quartonotebook/artifacts/external_rds_summary.tsv").md5 == '26d3aee09ee5b92e17f0dce912a750aa' },
                { assert multiqc_report.text.contains('community.wave.seqera.io/library/bioconductor-singlecellexperiment_bioconductor-summarizedexperiment_jupyter_matplotlib_pruned:0863a7410fcd16b6') },
            )
        }
    }
}
